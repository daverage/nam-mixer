# Optional local AI recipe assistant (Ollama OpenAI-compatible endpoint).
# Copy this file to .env, then adjust the model name if desired.
NAM_MIXER_LOCAL_LLM_MODEL=gemma4:e4b
NAM_MIXER_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
NAM_MIXER_LOCAL_LLM_TIMEOUT_SECONDS=60
NAM_MIXER_LOCAL_LLM_MAX_EXPLANATION_CHARS=1800
NAM_MIXER_LOCAL_LLM_MAX_REPLY_CHARS=1800
NAM_MIXER_LOCAL_LLM_TEMPERATURE=0.2
# Keep local conversations responsive. Structured source roles survive even
# when older prose is compacted before it reaches the model.
NAM_MIXER_LOCAL_LLM_MAX_TOKENS=1400
NAM_MIXER_LOCAL_LLM_HISTORY_MESSAGES=6
NAM_MIXER_LOCAL_LLM_HISTORY_MESSAGE_CHARS=900
NAM_MIXER_LOCAL_LLM_RESEARCH_CHARS=5000

# Optional TONE3000 capture search. Use a server-only Secret Key (t3k_cs_…).
# TONE3000_API_KEY=
