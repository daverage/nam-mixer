{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAM Mixer",
  "version": "0.5.4",
  "identifier": "com.nammixer.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../packaging/backend/dist/nam-mixer-backend": "nam-mixer-backend"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
